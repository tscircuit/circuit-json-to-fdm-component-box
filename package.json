{
  "name": "circuit-json-to-fdm-component-box",
  "version": "0.0.2",
  "description": "Generate multi-material 3MF component-organization boxes from Circuit JSON",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "circuit-json-to-fdm-component-box": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup-node lib/index.ts lib/cli.ts --format esm --dts --sourcemap",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "snapshot": "bun test tests/component-box-preview.test.ts",
    "snapshot:update": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/component-box-preview.test.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/circuit-json-to-fdm-component-box.git"
  },
  "keywords": [
    "3mf",
    "circuit-json",
    "fdm",
    "manifold",
    "tscircuit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tscircuit/image-utils": "^0.0.9",
    "@types/bun": "latest",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tscircuit/alphabet": "^0.0.25",
    "circuit-json": "^0.0.465",
    "fflate": "^0.8.3",
    "manifold-3d": "3.5.1",
    "poppygl": "^0.0.26"
  }
}
